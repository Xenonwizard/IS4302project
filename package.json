{
  "name": "courtyardproject",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "npm install && npm install --prefix blockchain",
    "chain": "npm --prefix blockchain run chain",
    "contracts:test": "npm --prefix blockchain test",
    "deploy:amoy": "npm --prefix blockchain run deploy:amoy",
    "test:smoke": "PLAYWRIGHT_CHANNEL=chrome playwright test",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.mts"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "viem": "^2.57.10",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.50.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
