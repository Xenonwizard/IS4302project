{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "slabyard-dev",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "dev.sh"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "pokechain-chain",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "export PATH=/opt/homebrew/bin:$PATH && npm run chain"
      ],
      "port": 8545
    }
  ]
}
