# Copy to .env.local. Every value is optional for the local chain.

# ---- blockchain (src/lib/chain/config.ts, src/lib/chain/operator.ts) ----
# local = Hardhat node on 127.0.0.1:8545 (default) · amoy = Polygon Amoy testnet
NEXT_PUBLIC_CHAIN=local
# Override the RPC the browser uses (e.g. an Alchemy / Infura Amoy URL)
# NEXT_PUBLIC_RPC_URL=
# Vault operator key (mints and ships slabs). Defaults to Hardhat account #0 on the local chain.
# On Amoy use the same key you deployed with (AMOY_PRIVATE_KEY in blockchain/).
# OPERATOR_PRIVATE_KEY=
# OPERATOR_RPC_URL=
# Only needed for WalletConnect / phone wallets. MetaMask in the browser works without it.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Grade10 custody check (src/lib/grade10/verify.ts) ----
# Default to this app's mocks. Point at real services to go live.
# GRADE10_API_URL=https://api.grade10.com/v1
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ---- negotiation chat replies (src/app/api/reply/route.ts) ----
# SOC_LLM_BASE_URL=
# SOC_LLM_API_KEY=
# SOC_LLM_MODEL=
